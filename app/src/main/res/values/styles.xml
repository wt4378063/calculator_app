<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CalcButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:textSize">26sp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:background">@drawable/button_bg</item>
    </style>

    <style name="NumberButton" parent="CalcButton">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="FunctionButton" parent="CalcButton">
        <item name="android:textColor">#1C1C1E</item>
    </style>

    <style name="OperatorButton" parent="CalcButton">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="EqualsButton" parent="CalcButton">
        <item name="android:textColor">@color/text_primary</item>
    </style>
</resources>
